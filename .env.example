# ==============================
# PostgreSQL
# ==============================
POSTGRES_DB=product-control
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/product-control

# ==============================
# Тестовая БД (отдельная)
# ==============================
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/product_control_test

# ==============================
# RabbitMQ (брокер Celery)
# ==============================
CELERY_BROKER_URL=amqp://admin:admin@rabbitmq:5672//
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# ==============================
# Redis (кэш и результат Celery)
# ==============================
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0

# ==============================
# MinIO (S3-совместимое хранилище)
# ==============================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ==============================
# API и приложение
# ==============================
WEB_PORT=8000
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ==============================
# API-ключ (защита эндпоинтов)
# ==============================
API_KEY_HEADER=X-API-Key
API_KEY=api_key1234567890   # Смените на свой надёжный ключ